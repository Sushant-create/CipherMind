# Copy this file to .env and fill in your actual API keys

# Hugging Face Inference API token, used by HuggingFaceAPIEmbedder in
# rag_engine.py to generate embeddings (all-MiniLM-L6-v2). Required.
HF_API_TOKEN=your_huggingface_api_token_here

# Groq API keys used for chat completions. rag_engine.py tries these in
# order (1 -> 2 -> 3) as fallbacks if one is missing, rate-limited, or fails.
# At least GROQ_API_KEY_1 is required.
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
PORT=8000
